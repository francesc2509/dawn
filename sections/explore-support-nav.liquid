{{ 'bc-content-2026.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section != false -%}
  {%- liquid
    assign current_path = request.path
  -%}
  <nav class="bc-explore bc-explore-nav" aria-label="Explore and support">
    <ul class="bc-explore-nav__list page-width">
      {%- for block in section.blocks -%}
        {%- if block.settings.show_link != false and block.settings.label != blank and block.settings.link != blank -%}
          {%- assign link_path = block.settings.link | split: '?' | first -%}
          {%- assign is_active = false -%}
          {%- if current_path == link_path -%}
            {%- assign is_active = true -%}
          {%- elsif request.page_type == 'blog' and block.settings.link contains blog.url -%}
            {%- assign is_active = true -%}
          {%- elsif request.page_type == 'page' and block.settings.link contains page.url -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li {{ block.shopify_attributes }}>
            <a
              class="bc-explore-nav__link{% if is_active %} is-active{% endif %}"
              href="{{ block.settings.link }}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {%- if block.settings.icon != blank -%}
                <span aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Explore support nav",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_link",
          "label": "Show link",
          "default": true
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon emoji"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Blog"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore support nav",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "icon": "📰",
            "label": "Blog",
            "link": "/blogs/news"
          }
        },
        {
          "type": "link",
          "settings": {
            "icon": "❓",
            "label": "Help & FAQs",
            "link": "/blogs/help-faqs"
          }
        },
        {
          "type": "link",
          "settings": {
            "icon": "🎬",
            "label": "Tutorials",
            "link": "/pages/bubble-crush-academy"
          }
        },
        {
          "type": "link",
          "settings": {
            "icon": "🎓",
            "label": "MASTERCLASS",
            "link": "/pages/bubble-tea-training-partnership-uk"
          }
        }
      ]
    },
    {
      "name": "About us nav",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "icon": "🏢",
            "label": "Our Story",
            "link": "/pages/about-bubble-crush"
          }
        },
        {
          "type": "link",
          "settings": {
            "icon": "✉️",
            "label": "Contact Us",
            "link": "/pages/contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
