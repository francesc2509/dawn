<style>
  /* --- 1. STRUCTURAL LOGIC (Header & Container) --- */
  .shopify-section.shopify-section-group-header-group.section-header:not(:has(header details-modal.header__search > details[open])) + main > section > .carousel-container:first-of-type {
    margin-top: calc(-1 * var(--header-height));
    transition: margin 700ms;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }

  .carousel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: nowrap;
    left: 0;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .dawn-carousel-item {
    flex: 1 0 100%;
    min-height: 100%;
    min-width: 100%;
    position: relative;
  }

  .dawn-carousel-item img, .dawn-carousel-item video {
    object-fit: cover;
    object-position: center;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* --- 2. TYPOGRAPHY & HERO TEXT (Restored) --- */
  .carousel-curtain {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2em 0.5em;
    box-sizing: border-box;
    color: white !important;
  }

  .carousel-hero {
    text-align: center;
    color: rgb(var(--color-foreground));
    text-shadow: 0 0 10px rgba(0,0,0,0.9); /* Critical for readability */
    max-width: 65%;
    margin-top: 2em;
    /* Animation */
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.5s ease-in forwards 0.5s;
  }

  .carousel-hero > .hero-title > h1 { font-size: 0.75em; }
  .carousel-hero > .hero-title, 
  .carousel-hero > .hero-subtitle {
    color: inherit;
    text-align: center;
  }
  .carousel-hero > .hero-subtitle { font-size: 0.75em; }
  .hero-main { text-align: center; }
  .carousel-hero > p { word-break: keep-all; }

  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- 3. CTA BUTTONS & NAVIGATION --- */
  .carousel-hero > .carousel-hero-cta-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-shadow: none;
    padding: 1em;
    box-sizing: border-box;
  }

  .carousel-hero > .carousel-hero-cta-container a {
    min-height: 4em;
    flex: 1;
  }

  .carousel-nav-container {
    width: 100%;
    position: absolute;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    top: var(--header-height);
    left: 0;
  }

  .carousel-nav {
    flex: 0 0 5em;
    display: flex;
    gap: 0.25em;
    padding: 0.25em 0;
    align-items: center;
    overflow: auto;
  }

  .carousel-nav-item {
    flex: 0 0 10px;
    height: 10px;
    background: rgba(1, 1, 1, 0.5);
    border-radius: 100%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    cursor: pointer;
  }

  .carousel-nav-item.active {
    background: rgba(255, 255, 255, 1);
    border: 1px solid rgba(1, 1, 1, 0.5);
  }

  /* --- 4. MOBILE RESPONSIVENESS (Restored) --- */
  @media (max-width: 768px) {
    .carousel-curtain {
      padding-bottom: 36px;
      justify-content: flex-start;
    }

    .carousel-hero {
      max-width: initial;
      width: 100%;
      transition: padding 1s ease;
    }

    .carousel-hero > .hero-title { font-size: 1.5em; }
    .carousel-hero > .hero-title > h1 { font-size: 0.5em; }
    .carousel-hero > .hero-subtitle { font-size: 0.75em; }

    .shopify-section.section-header:not(.scrolled-past-header) + main > section > .carousel-container .carousel-hero {
      padding-bottom: 2vh;
      transition: padding 0.5s ease;
    }

    .carousel-hero > .carousel-hero-cta-container { align-items: normal; }
  }
</style>

<div class="carousel-container">
  <div class="carousel">
    {% for block in section.blocks %}
      <div
        class="dawn-carousel-item{% if block.settings.slide_position %} {{ block.settings.slide_position }}{% endif %}{% if block.settings.slide_fit %} {{ block.settings.slide_fit }}{% endif %} color-{{ block.settings.color_scheme }}"
        {% if block.settings.slide_duration %}
          data-duration="{{ block.settings.slide_duration }}"
        {% endif %}
      >
        {% if block.settings.video -%}
          
          <video muted playsinline>
            {% if block.settings.video_mobile %}
              <source
                src="{{ block.settings.video_mobile.sources.last.url }}"
                type="video/mp4"
                media="(max-width: 768px)"
              >
            {% endif %}

            {% assign desktop_video = block.settings.video %}
          {% if desktop_video != blank %}
            {% assign mp4_source = desktop_video.sources | where: "format", "mp4" | first %}
            {% if mp4_source %}
              <source src="{{ mp4_source.url }}" type="video/mp4">
            {% endif %}
          {% endif %}
          </video>
        {% elsif block.settings.image %}
          <picture>
            {% if block.settings.image_mobile %}
              <source
                media="(max-width: 768px)"
                srcset="{{ block.settings.image_mobile | image_url: width: 768 }}"
              >
            {% endif %}

            <img
              src="{{ block.settings.image | image_url: width: 1440 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          </picture>
        {% endif %}
        <div class="carousel-curtain" style="background: linear-gradient(180deg,rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.slide_overlay_alpha }}) 100%);">
          <div class="carousel-hero">
            <div class="hero-title">
              {% if block.settings.hero_title_seo != blank %}
                {{ block.settings.hero_title_seo }}
              {% endif %}
              {% if block.settings.hero_title != blank %}
                {{ block.settings.hero_title }}
              {% endif %}
            </div>

            {% if block.settings.hero_main != blank %}
              <div class="hero-main">
                {{ block.settings.hero_main }}
              </div>
            {% endif %}

            {% if block.settings.hero_subtitle != blank %}
              <div class="hero-subtitle">
                {{ block.settings.hero_subtitle }}
              </div>
            {% endif %}

            <div class="carousel-hero-cta-container">
              {% assign hero_cta_url = block.settings.hero_cta_url  %}
              {% assign hero_cta_label = block.settings.hero_cta_label  %}
              {% assign hero_secondary_cta_url = block.settings.hero_secondary_cta_url  %}
              {% assign hero_secondary_cta_label = block.settings.hero_secondary_cta_label  %}
              
              {% if customer %}
              {% endif %}
              {% if hero_cta_url  != blank %}
                <a
                  href="{{ block.settings.hero_cta_url }}"
                  class="button button--primary"
                >
                  {{ hero_cta_label }}
                </a>
              {% endif %}
              {% if hero_secondary_cta_url  != blank %}
                <a
                    href="{{ block.settings.hero_secondary_cta_url }}"
                    class="link link--text"
                  >
                    {{ hero_secondary_cta_label }}
                </a>
              {% endif %}
            </div>
            
            
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="carousel-nav-container hidden">
    <div class="carousel-nav">
      {% for block in section.blocks %}
        <div class="carousel-nav-item {% if forloop.index == 1 %} active{% endif %}"></div>
      {% endfor %}
    </div>
  </div>
</div>

<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Carousel",
  "tag": "section",
  "class": "section",
  "presets": [{ "name": "Carousel" }],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "info": "t:sections.all.colors.has_cards_info",
          "default": "background-1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.video.settings.video.label"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Vidéo mobile"
        },
        {
          "type": "number",
          "id": "slide_duration",
          "label": "Duration (secondes)"
        },
        {
          "type": "select",
          "id": "slide_fit",
          "options": [
            {
              "value": "fill",
              "label": "Fill"
            },
            {
              "value": "cover",
              "label": "Cover"
            }
          ],
          "default": "cover",
          "label": "t:sections.collage.settings.desktop_layout.label"
        },
        {
          "type": "select",
          "id": "slide_position",
          "options": [
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "left",
              "label": "t:sections.collage.settings.desktop_layout.options__1.label"
            },
            {
              "value": "right",
              "label": "t:sections.collage.settings.desktop_layout.options__2.label"
            }
          ],
          "default": "left",
          "label": "t:sections.collage.settings.desktop_layout.label"
        },
        {
          "type": "range",
          "id": "slide_overlay_alpha",
          "label": "Overlay alpha",
          "default": 0.3,
          "min": 0,
          "max": 1,
          "step": 0.1,
          "unit": "%"
        },
        {
          "type": "richtext",
          "id": "hero_title_seo",
          "label": "Section hero titre"
        },
        {
          "type": "richtext",
          "id": "hero_title",
          "label": "Section hero titre"
        },
        {
          "type": "richtext",
          "id": "hero_subtitle",
          "label": "Section hero sous-titre"
        },
        {
          "type": "richtext",
          "id": "hero_main",
          "label": "Section hero"
        },
        {
          "type": "richtext",
          "id": "hero_cta_label",
          "label": "Section hero CTA label"
        },
        {
          "type": "url",
          "id": "hero_cta_url",
          "label": "Section hero CTA"
        },
        {
          "type": "richtext",
          "id": "signed_in_hero_cta_label",
          "label": "Signed-in section hero CTA label"
        },
        {
          "type": "url",
          "id": "signed_in_hero_cta_url",
          "label": "Signed-in section hero CTA"
        },
        {
          "type": "richtext",
          "id": "hero_secondary_cta_label",
          "label": "Section hero secondary CTA label"
        },
        {
          "type": "url",
          "id": "hero_secondary_cta_url",
          "label": "Section hero secondary CTA"
        },
        {
          "type": "richtext",
          "id": "signed_in_hero_secondary_cta_label",
          "label": "Signed-in section hero secondary CTA label"
        },
        {
          "type": "url",
          "id": "signed_in_hero_secondary_cta_url",
          "label": "Signed-in section hero secondary CTA"
        }
      ]
    }
  ]
}
{% endschema %}
