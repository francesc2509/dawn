{{ 'about-page-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.show_section != false -%}
  <div class="section-{{ section.id }}-padding">
    <div class="about-top-banner page-width">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', alt: section.settings.image_alt, widths: '430, 768, 1200, 1600', sizes: '(max-width: 1200px) 100vw, 1200px'
        }}
      {%- elsif section.settings.fallback_image_url != blank -%}
        <img
          src="{{ section.settings.fallback_image_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          loading="lazy"
          width="1600"
          height="900"
        >
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About — top banner image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Default image URL (if no image selected)",
      "default": "https://cdn.shopify.com/s/files/1/0782/7999/9817/files/20260917114843_714_1.png?v=1758033160"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Bubble Crush team at the London warehouse"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "presets": [{ "name": "About — top banner image" }]
}
{% endschema %}
