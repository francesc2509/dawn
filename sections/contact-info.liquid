{% schema %}
{
  "name": "Contact info",
  "tag": "section",
  "class": "section",
  "presets": [{ "name": "Carousel" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "contact_info_phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "contact_info_email",
      "label": "E-mail"
    },
    {
      "type": "text",
      "id": "contact_info_address",
      "label": "Address"
    },
    {
      "type": "select",
      "id": "contact_info_map",
      "options": [
        {
          "value": "static",
          "label": "Static"
        },
        {
          "value": "interactive",
          "label": "Interactive"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "static",
      "label": "Map"
    }
  ]
}
{% endschema %}
