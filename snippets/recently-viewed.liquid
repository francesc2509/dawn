<style>
  #recently-viewed {
    margin: 2em 0;
  }
</style>

<div id="recently-viewed" class="quick-add-hidden">
  <h2 class="related-products__heading h2">Recently viewed</h2>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const container = document.getElementById('recently-viewed');
    if (!container) return;

    let handles = [];
    try {
      handles = JSON.parse(localStorage.getItem('recently_viewed')) || [];
    } catch (e) {
      handles = [];
    }
    if (!Array.isArray(handles) || !handles.length) return;

    // Cap the number of handles queried to keep the request small and fast.
    const query = handles
      .slice(0, 4)
      .filter((h) => typeof h === 'string' && h.length)
      .map((h) => `handle:${h}`)
      .join(' OR ');

    if (!query) return;

    try {
      const res = await fetch(`/search?q=${encodeURIComponent(query)}&type=product&view=recently-viewed`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const html = await res.text();
      if (html.trim()) {
        container.insertAdjacentHTML('beforeend', html);
      }
    } catch (e) {
      console.error('Recently viewed fetch failed', e);
    }
  });
</script>
