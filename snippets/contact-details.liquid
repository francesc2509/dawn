{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- style -%}
  .contact-details-container {
    display: flex;
    flex-direction: row-reverse;
    padding: 0 1em 1em 1em;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-details-container * {
    padding: 0;
    margin: 0;
  }

  .contact-details-container .contact-details-map {
    max-width: 100%;
    position: relative;
    display: flex;
  }

  .contact-details-container a {
    color: inherit;
  }

  .contact-details-container .contact-details-map > span {
    position: absolute;
    background: linear-gradient(270deg, rgba(var(--color-foreground), 0), rgba(var(--color-foreground), 0.25));
    color: rgb(var(--color-background));
    padding: 0em 0.5em;
    bottom: 0%;
    box-sizing: border-box;
    width: 100%;
  }

  .contact-details-container .contact-details-map > img {
    max-width: 100%;
  }

  .contact-details-container ul {
    list-style-type: none;
  }

  .contact-details-container .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .contact-details-container {
      flex-direction: column;
      gap: 1em;
    }
  }
{%- endstyle -%}
  <div class="contact-details-container">
    <div class="contact-details">
      <ul>
        <li><a href="https://wa.me/+447512896659">{{ shop.phone }}</a></li>
        <li><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
        <li><a href="https://{{ shop.domain }}">www.{{ shop.domain }}</a></li>
        <li>{{ shop.address.address1 }}, {{ shop.address.zip }}, {{ shop.address.city }}, {{ shop.address.country_code }}</li>
      </ul>
    </div>
    {% assign hq_location = shop.metaobjects.hq_location.values | first %}
    {% if iframe_enabled %}
      <iframe src="{{ hq_location.embedded_google_maps_link }}"
        width="640px"
        height="auto"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    {% else %}
      
      <a class="contact-details-map" href="{{ hq_location.location_static_image_link }}">
        <span>{{ hq_location.location_static_image_text  }}&nbsp;{% render 'icon-arrow' %}</span>
        {{ hq_location.location_static_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
      </a>
    {% endif %}
  </div>
