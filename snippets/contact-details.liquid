{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- style -%}

  .main-page-title {
    display: none;
  }
  
  .contact-details-container {
    display: flex;
    flex-direction: row;
    padding: 0 1em 1em 1em;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-details-container * {
    padding: 0;
    margin: 0;
  }

  .contact-details-container .contact-details-map {
    max-width: 100%;
    position: relative;
    display: flex;
  }

  .contact-details-container a {
    color: inherit;
  }

  .contact-details-container .contact-details-map > span {
    position: absolute;
    background: #fff;
    color: rgb(26, 115, 232);
    padding: 0em 0.5em;
    top: 0%;
    box-sizing: border-box;
    margin: 0.25em;
  }

  .contact-details-container .contact-details-map > img {
    max-width: 100%;
    height: auto; /* Maintains the natural aspect ratio */
    display: block;
    object-fit: cover; /* Ensures the image fills the area without distorting */
  }

  .contact-details-container ul {
    list-style-type: none;
    padding: 0.5em 0;
    box-sizing: border-box;
  }

  .contact-details-container .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-info-icon > svg {
    height: 1em;
    font-size: 1em;
    padding: 0 0.25em;
    box-sizing: border-box;
  }

  .contact-details-instant-messaging {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-size: 0.5em;
  }

  @media screen and (max-width: 900px) {
    .contact-details-container {
      flex-direction: column;
      gap: 1em;
    }
    
    .contact-details-container .contact-details {
      max-width: 100%;
    }
  }
{%- endstyle -%}
<div>
  {% if title != blank %}
    {{ title }}
  {% endif %}
  <div class="contact-details-container">
    
    {% if settings.social_wechat_qr %}
    <div class="contact-details-instant-messaging">
      <div>
        <div>Message us on WeChat</div>
        {{ settings.social_wechat_qr | image_url: width: 150 | image_tag: loading: 'lazy', alt: settings.social_wechat_qr.alt }}
      </div>
    </div>
    {% endif %}
    <div class="contact-details">
      <ul>
        <li><span class="contact-info-icon">{% render 'icon-mobile-phone' %}</span><a href="https://wa.me/+447512896659">{{ shop.phone }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-envelope' %}</span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-globe-europe' %}</span><a href="https://{{ shop.domain }}">www.{{ shop.domain }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-home' %}</span>{% if shop.address.address1 != blank %}{{ shop.address.address1 }}{% endif %}
        {% if shop.address.address2 != blank %}{{ shop.address.address2 }}{% endif %},
        {% if shop.address.zip != blank %}{{ shop.address.zip }}, {% endif %}
        {% if shop.address.city != blank %}{{ shop.address.city }}, {% endif %}
        {{ shop.address.country_code }}
        </li>
      </ul>
    </div>
    {% if iframe_enabled and settings.brand_maps_iframe_url %}
      <iframe src="{{ settings.brand_maps_iframe_url }}"
        class=""
        style="border:0; min-width: 40%; max-width: 100%;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    {% elsif settings.brand_maps_image != blank %}
      {% if settings.brand_maps_url != blank %}
      <a class="contact-details-map" href="{{ settings.brand_maps_url }}" target="_blank">
      {% endif %}
        {% if settings.brand_maps_url_label != blank  %}
        <span>{{ settings.brand_maps_url_label  }}&nbsp;{% render 'icon-arrow' %}</span>
        {% endif %}
        {% if settings.brand_maps_image %}
        {{ settings.brand_maps_image | image_url: width: 500 | image_tag: loading: 'lazy' }}
        {% endif %}
      {% if settings.brand_maps_url != blank %}
      </a>
      {% endif %}
    {% endif %}
  </div>
  </div>
