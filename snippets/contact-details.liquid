{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .contact-details-container {
    display: flex;
    flex-direction: row-reverse;
    padding: 0 1em 1em 1em;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-details-container * {
    padding: 0;
    margin: 0;
  }

  .contact-details-container .contact-details-map {
    max-width: 100%;
    position: relative;
    display: flex;
  }

  .contact-details-container a {
    color: inherit;
  }

  .contact-details-container .contact-details-map > span {
    position: absolute;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    padding: 0em 0.5em;
    bottom: 0%;
    box-sizing: border-box;
  }

  .contact-details-container .contact-details-map > img {
    max-width: 100%;
  }

  .contact-details-container ul {
    list-style-type: none;
  }

  .contact-details-container .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .contact-details-container {
      flex-direction: column;
      gap: 1em;
    }
  }
{%- endstyle -%}
  <div class="contact-details-container">
    <div class="contact-details">
      <ul>
        <li>{{ shop.address.address1 }}, {{ shop.address.zip }}, {{ shop.address.city }}, {{ shop.address.country_code }}</li>
        <li>{{ shop.phone }}</li>
        <li><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
        <li><a href="https://{{ shop.domain }}">www.{{ shop.domain }}</a></li>
      </ul>
    </div>
    {% if iframe_enabled %}
      <iframe src=""
        width="640px"
        height="auto"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    {% else %}
      {% assign hq_location = shop.metaobjects.hq_location.values | first %}
      <a class="contact-details-map" href="{{ hq_location.location_static_image_link }}">
        <span>{{ hq_location.location_static_image_text  }}</span>
        {{ hq_location.location_static_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
      </a>
    {% endif %}
  </div>
