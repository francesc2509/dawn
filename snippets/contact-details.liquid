{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- style -%}

  .main-page-title {
    display: none;
  }
  
  .contact-details-container {
    display: flex;
    flex-direction: row;
    padding: 0 1em 1em 1em;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-details-container * {
    padding: 0;
    margin: 0;
  }

  .contact-details-container .contact-details-map {
    max-width: 100%;
    position: relative;
    display: flex;
  }

  .contact-details-container a {
    color: inherit;
  }

  .contact-details-container .contact-details-map > span {
    position: absolute;
    background: linear-gradient(270deg, rgba(var(--color-foreground), 0), rgba(var(--color-foreground), 0.25));
    color: rgb(var(--color-background));
    padding: 0em 0.5em;
    bottom: 0%;
    box-sizing: border-box;
    width: 100%;
  }

  .contact-details-container .contact-details-map > img {
    max-width: 100%;
    height: auto; /* Maintains the natural aspect ratio */
    display: block;
    object-fit: cover; /* Ensures the image fills the area without distorting */
  }

  .contact-details-container ul {
    list-style-type: none;
    padding: 0.5em 0;
    box-sizing: border-box;
  }

  .contact-details-container .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-info-icon > svg {
    height: 1em;
    font-size: 1em;
    padding: 0 0.25em;
    box-sizing: border-box;
  }

  @media screen and (max-width: 900px) {
    .contact-details-container {
      flex-direction: column;
      gap: 1em;
    }
    
    .contact-details-container .contact-details {
      max-width: 100%;
    }
  }
{%- endstyle -%}
  <div class="contact-details-container">
    
    <div class="contact-details">
      {% if title != blank %}
        {{ title }}
      {% endif %}
      <ul>
        <li><span class="contact-info-icon">{% render 'icon-mobile-phone' %}</span><a href="https://wa.me/+447512896659">{{ shop.phone }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-envelope' %}</span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-globe-europe' %}</span><a href="https://{{ shop.domain }}">www.{{ shop.domain }}</a></li>
        <li><span class="contact-info-icon">{% render 'icon-home' %}</span>{% if shop.address.address1 != blank %}{{ shop.address.address1 }} {% endif %}
        {% if shop.address.address2 != blank %}{{ shop.address.address2 }} {% endif %},
        {% if shop.address.zip != blank %}{{ shop.address.zip }}, {% endif %}
        {% if shop.address.city != blank %}{{ shop.address.city }}, {% endif %}
        {{ shop.address.country_code }}
        </li>
      </ul>
    </div>
    {% assign hq_location = shop.metaobjects.hq_location.values | first %}
    {% if iframe_enabled %}
      <iframe src="{{ hq_location.embedded_google_maps_link }}"
        width="600"
        height="450" style="border:0; max-width: 100%;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    {% else %}
      <a class="contact-details-map" href="{{ hq_location.location_static_image_link }}">
        <span>{{ hq_location.location_static_image_text  }}&nbsp;{% render 'icon-arrow' %}</span>
        {{ hq_location.location_static_image | image_url: width: 500 | image_tag: loading: 'lazy' }}
      </a>
    {% endif %}
    <div style="text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center;">
      <img src="https://cdn.shopify.com/s/files/1/0782/7999/9817/files/IMG_9835.jpg?v=1775062128" width="200">
      <span>WeChat</span>
    </div>
  </div>
