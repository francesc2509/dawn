{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- style -%}

  .main-page-title {
    display: none;
  }
  
  .contact-details-container {
    display: flex;
    flex-direction: row;
    padding: 0 1em 1em 1em;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-details-container * {
    padding: 0;
    margin: 0;
  }

  .contact-details-container .contact-details-map {
    max-width: 100%;
    position: relative;
    display: flex;
  }

  .contact-details-container a {
    color: inherit;
  }

  .contact-details-container .contact-details-map > span {
    position: absolute;
    background: linear-gradient(270deg, rgba(var(--color-foreground), 0), rgba(var(--color-foreground), 0.25));
    color: rgb(var(--color-background));
    padding: 0em 0.5em;
    bottom: 0%;
    box-sizing: border-box;
    width: 100%;
  }

  .contact-details-container .contact-details-map > img {
    max-width: 100%;
  }

  .contact-details-container ul {
    list-style-type: none;
  }

  .contact-details-container .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 900px) {
    .contact-details-container {
      flex-direction: column;
      gap: 1em;
    }
    
    .contact-details-container .contact-details {
      max-width: 100%;
    }
  }
{%- endstyle -%}
  <div class="contact-details-container">
    
    <div class="contact-details">
      <h1>{{ title }}</h1>
      <ul>
        <li><span class="contact-info-icon"></span><a href="https://wa.me/+447512896659">{{ shop.phone }}</a></li>
        <li><span class="contact-info-icon"></span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
        <li><span class="contact-info-icon"></span><a href="https://{{ shop.domain }}">www.{{ shop.domain }}</a></li>
        <li><span class="contact-info-icon"></span>
        {% if shop.address.address1 != blank %}{{ shop.address.address1 }}, {% endif %}
        {% if shop.address.address2 != blank %}{{ shop.address.address2 }}, {% endif %}
        {% if shop.address.zip != blank %}{{ shop.address.zip }}, {% endif %}
        {% if shop.address.city != blank %}{{ shop.address.city }}, {% endif %}
        {{ shop.address.country_code }}
        </li>
      </ul>
    </div>
    {% assign hq_location = shop.metaobjects.hq_location.values | first %}
    {% if iframe_enabled %}
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2413.4186364093844!2d-0.040075900000000005!3d51.48400590000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487602e4b0f07d2b%3A0xd91b9fb82d55302a!2sParkside%20Business%20Estate%2C%20Blackhorse%20Rd%2C%20London%20SE8%205HZ!5e1!3m2!1sen!2suk!4v1774725593393!5m2!1sen!2suk" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    {% else %}
      <a class="contact-details-map" href="{{ hq_location.location_static_image_link }}">
        <span>{{ hq_location.location_static_image_text  }}&nbsp;{% render 'icon-arrow' %}</span>
        {{ hq_location.location_static_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
      </a>
    {% endif %}
  </div>
