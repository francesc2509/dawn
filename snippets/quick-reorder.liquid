{% if customer and customer.orders_count > 0 %}
  {% comment %} {% assign customer_products = collections['all'].products %} {% endcomment %}
  <div class="page-width">
    <h2 class="h1">Restock Your Favorites</h2>
    <ul class="grid grid--2-col grid--4-col-desktop">
      {%- assign displayed_products = "" -%}
      {%- assign count = 0 -%}
      {% for order in customer.orders %}
        {% for item in order.line_items %}
          {% unless displayed_products contains prod.id or count >= 4 or prod == blank %}
            <li class="grid__item">
              {% render 'card-product',
                card_product: prod,
                media_aspect_ratio: block.settings.image_ratio,
                show_secondary_image: false,
                lazy_load: false,
                quick_add: 'bulk',
                section_id: section.id,
                horizontal_quick_add: false
              %}
            </li>
            {%- assign displayed_products = displayed_products | append: prod.id | append: "," -%}
            {%- assign count = count | plus: 1 -%}
          {% endunless %}
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
{% endif %}